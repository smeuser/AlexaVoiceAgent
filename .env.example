# Kopiere diese Datei nach ".env" und passe die Werte an.

# Pfad zu deinem Obsidian-Vault (der Ordner mit den .md-Dateien)
VAULT_PATH=C:\Users\DEIN_NAME\Documents\ObsidianVault

# In welchem Unterordner des Vaults das Modell neue Erinnerungen ablegt
MEMORY_FOLDER=KI-Gedaechtnis

# Ollama
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# Alexa: Skill-ID aus der Developer Console (amzn1.ask.skill....)
# Solange leer, wird die Skill-ID nicht geprüft (nur für erste Tests okay).
ALEXA_SKILL_ID=

# Geheimes Token für den Relay-Weg (Alexa-hosted Skill als Vermittler).
# Ein langer Zufallswert, z.B. 40+ Zeichen. Muss identisch in der
# Lambda-Funktion (skill/lambda_relay.py) eingetragen werden.
RELAY_TOKEN=

# Server
HOST=0.0.0.0
PORT=8000
